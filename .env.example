# GérerTales Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# AI Provider Configuration
# ============================================
# xAI (Grok) - Primary AI provider for text generation
# Get from: https://console.x.ai
VITE_XAI_API_KEY=xai-your-key-here

# OpenAI - Used for TTS and fallback
# Get from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-key-here

# Google Gemini - Optional (currently disabled)
# VITE_GEMINI_API_KEY=your-gemini-key-here

# ============================================
# Text-to-Speech Configuration
# ============================================
# ElevenLabs - Premium TTS provider
# Get from: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ============================================
# Payment Integration
# ============================================
# Stripe - For subscription management
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_your-key-here

# ============================================
# Optional: Local AI Server
# ============================================
# URL for local GérerLlama instance (if running)
# VITE_GERERLLAMA_URL=http://localhost:3001/api/generate
# VITE_GERERLLAMA_KEY=your-local-key-here

# ============================================
# Deployment Configuration
# ============================================
# Production URL (used for OAuth redirects)
# VITE_APP_URL=https://your-app.netlify.app
